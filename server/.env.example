# Copy this file to .env and fill in real values before running.

# Port the API listens on
PORT=4000

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# How long a login session stays valid
JWT_EXPIRES_IN=7d

# Where the browser app is served from, so CORS lets it through.
# In dev this is the Vite server; in production it's your deployed frontend URL.
CLIENT_ORIGIN=http://localhost:5173
